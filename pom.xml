<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>underknown.simulatedApp</groupId>
    <artifactId>stockMarket</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Tool</name>
    <description>Various calculations and data retrieval</description>

    <properties>
        <maven.compiler.version>3.11.0</maven.compiler.version>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <java.version>21</java.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>
			<plugin>
			    <groupId>org.apache.maven.plugins</groupId>
			    <artifactId>maven-jar-plugin</artifactId>
			    <version>3.4.2</version>
			    <configuration>
			        <archive>
			            <manifest>
			                <mainClass>underknown.simulatedApp.SimulatedAppTestApplication</mainClass>
			            </manifest>
			        </archive>
			    </configuration>
			</plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>

                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>

                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>shaded</shadedClassifierName>

                            <createDependencyReducedPom>false</createDependencyReducedPom>

                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>underknown.simulatedApp.SimulatedAppTestApplication</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
    			<groupId>com.akathist.maven.plugins.launch4j</groupId>
    			<artifactId>launch4j-maven-plugin</artifactId>
    			<version>2.5.0</version>

    			<executions>
        			<execution>
            			<phase>package</phase>
            			<goals>
                			<goal>launch4j</goal>
            			</goals>
        			</execution>
    			</executions>

    			<configuration>
        			<outfile>${project.build.directory}/SimulatedApp.exe</outfile>
        			<jar>${project.build.directory}/${project.build.finalName}-shaded.jar</jar>
        			<headerType>gui</headerType>
        			<dontWrapJar>false</dontWrapJar>
    			</configuration>
			</plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.14.1</version>
        </dependency>
    </dependencies>

</project>
